# Server Port (Default is 3000)
PORT=3000

# Recipient email address where contact messages should be delivered
CONTACT_EMAIL=riyaasoni178@gmail.com

# Transactional Email API Key
# Recommended: Resend (https://resend.com) - free 100 emails/day, 3,000/month
# Example: EMAIL_API_KEY=re_123456789abcdef
# Also compatible with SendGrid API keys: EMAIL_API_KEY=SG.123456...
EMAIL_API_KEY=your_email_api_key_here

# Sender email address
# If using Resend without a custom domain, you can use Resend's verified test address: onboarding@resend.dev
# Once your domain is verified on Resend, change this to: Contact <contact@yourdomain.com>
EMAIL_FROM=onboarding@resend.dev

# (Optional) Alternative: SMTP Configuration
# If you prefer using standard SMTP (like Gmail App Password) instead of an API key, uncomment and set these:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=riyaasoni178@gmail.com
# SMTP_PASS=your_gmail_app_password
